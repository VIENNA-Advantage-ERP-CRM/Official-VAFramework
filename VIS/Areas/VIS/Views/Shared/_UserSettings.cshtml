﻿@if (Request.IsAuthenticated && !string.IsNullOrEmpty(ViewBag.IsAuthorize))
{
    @model VIS.Models.LoginModel



    @functions{


        public string GetMsg(string lang, string key)
        {
            return VAdvantage.Utility.Msg.GetMsg(lang, key);
        }

        public string GetHSStyle(dynamic hs,bool colorOnly = false)
        {
            if (hs == null)
            {
                return "";
            }
            else
            {
                System.Text.StringBuilder sb = new System.Text.StringBuilder();

                if (hs.Background != null)
                {

                    sb.Append("background:").Append(hs.Background).Append(";"); ;
                }
                if (hs.Color != null)
                {

                    sb.Append("color:").Append(hs.Color).Append(";");
                }

                if (colorOnly)
                {
                    return sb.ToString();
                }

                if (hs.Height != null && hs.Height > 0)
                {

                    sb.Append("height:").Append(hs.Height).Append("px;");
                }

                if (hs.Style != null)
                {
                    sb.Append(hs.Style);
                }

                if (ViewBag.PageSection.HS.IsHorzonatlSplitMenu)
                {
                    sb.Append("border-bottom:unset;");
                }


                return sb.ToString();
            }
        }

        public string GetSMStyle(dynamic sm)
        {
            if (sm == null)
            {
                return "";
            }
            else
            {
                System.Text.StringBuilder sb = new System.Text.StringBuilder();
                if (sm.Background != null)
                {

                    sb.Append("background:").Append(sm.Background).Append(";"); ;
                }
                if (sm.Color != null)
                {

                    sb.Append("color:").Append(sm.Color).Append(";");
                }
                if (sm.Height != null && sm.Height > 0)
                {

                    sb.Append("height:").Append(sm.Height).Append("px;");
                }
                if (sm.Style != null)
                {
                    sb.Append(sm.Style);
                }

                return sb.ToString();
            }
        }
    }
}


